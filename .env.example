# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# Private key of the dedicated Base Sepolia throwaway demo wallet.
# Holds testnet gas only — no other funds, no other role.
FINNE_BASE_PRIVATE_KEY=

# Base Sepolia RPC endpoint. The public endpoint below needs no signup;
# swap in an Alchemy/Infura/QuickNode URL if it's ever unreliable.
BASE_RPC_URL=https://sepolia.base.org
